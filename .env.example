# ==========================================================
# .env.example  -  PLANTILLA DE VARIABLES DE ENTORNO
# ----------------------------------------------------------
# Este archivo SÍ se sube al repositorio: sirve para que
# cualquiera sepa qué variables necesita el proyecto.
#
# El archivo .env de verdad NO se sube nunca (está en el
# .gitignore), porque es donde van las claves y los secretos.
#
# Para empezar: copia este archivo y renómbralo a ".env".
# ==========================================================

# Puerto en el que escucha el servidor.
# En Render esta variable la define la plataforma sola.
PORT=3000

# Entorno de ejecución: development o production.
# En producción no mostramos detalles técnicos de los errores.
NODE_ENV=development

# Orígenes a los que CORS les permite llamar a esta API,
# separados por comas y SIN barra al final.
# Al publicar hay que agregar aquí la URL de Netlify.
ORIGENES_PERMITIDOS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
